{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "小鲸鱼 · ChatGPT 网页完成提醒",
  "version": "0.7.0",
  "description": "ChatGPT 网页回复完成时通知小鲸鱼，并分别统计 Chrome/Edge 的 6 Pro 提问次数。",
  "action": { "default_popup": "popup.html", "default_title": "小鲸鱼网页提醒" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "https://chatgpt.com/*"],
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
